{
  "name": "naiwa-motion-lab",
  "private": true,
  "version": "0.1.0",
  "description": "Naiwa Motion Lab: a soft-body + skeleton 奶蛙 you can poke, throw and make dance with your camera, a video or preset dances, in the browser.",
  "type": "module",
  "engines": {
    "node": ">=18.19"
  },
  "scripts": {
    "dev": "vite",
