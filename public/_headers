# Cloudflare Pages response headers (copied into dist/ by the build). Keep in step with vercel.json; `npm run e2e`
# checks that both give every built file the same Cache-Control.
# Rules must not overlap for one header: Cloudflare joins repeated headers with commas.

# Vite's content-hashed bundles never change under one name.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Unhashed big files (MediaPipe wasm + pose model, the frog GLB, dance tracks): kept in the browser cache but
# revalidated (ETag, 304) on every use, so a deploy that replaces them under the same name is picked up at once.
/mediapipe/*
  Cache-Control: public, max-age=0, must-revalidate
/models/*
  Cache-Control: public, max-age=0, must-revalidate
/dances/*
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache

/*
  X-Content-Type-Options: nosniff
